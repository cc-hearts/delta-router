{
  "listen": { "host": "127.0.0.1", "port": 8788 },
  "tls": { "ca": "certs/ca.pem", "cert": "certs/server.crt", "key": "certs/server.key" },
  "intercept": ["api.anthropic.com", "api.openai.com", "opencode.ai"],
  "routes": {
    "api.anthropic.com": {
      "ccswitchAppType": "claude",
      "authStyle": "both"
    },
    "api.openai.com": {
      "ccswitchAppType": "codex",
      "authStyle": "bearer",
      "modelFallback": ["gpt-5.6-sol"]
    },
    "opencode.ai": {
      "ccswitchAppType": "opencode",
      "authStyle": "bearer",
      "stripPrefix": ["/zen/go", "/zen"]
    }
  },
  "ccswitch": { "db": "~/.cc-switch/cc-switch.db", "cacheMs": 15000 },
  "upstreamTimeoutMs": 600000,
  "logFile": "logs/router.log"
}
